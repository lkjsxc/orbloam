r:1px solid #b6dec177;color:#e2f4e9;z-index:40;box-shadow:var(--shadow);font-size:13px;text-align:center;line-height:1.6}.backlog{position:fixed;top:103px;left:50%;transform:translateX(-50%);z-index:8;border-radius:12px;padding:12px 18px;display:flex;align-items:center;gap:14px;max-width:calc(100% - 32px)}.backlog b{font-size:12px;display:block;font-weight:500}.backlog span:last-child{display:block;font-size:11px;color:var(--muted);margin-top:4px}.spinner{width:16px;height:16px;display:block;border:2px solid #9dd5bc22;border-top-color:#9dd5bc;border-radius:50%;animation:spin 1.2s linear infinite}.notice{position:fixed;bottom:90px;left:50%;transform:translateX(-50%);z-index:9;border-radius:12px;padding:10px 15px;display:flex;align-items:center;gap:12px;font-size:12px;max-width:calc(100% - 32px)}.notice button{white-space:nowrap}.notice#pending{border-color:#d4b88b77;bottom:145px}.notice .icon{padding:4px 7px}\n.veil{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(ellipse at center,#101b2266,#070d12b5);z-index:20;overflow-y:auto;padding:30px 15px}.auth-card{width:460px;padding:34px 40px;border-radius:22px;text-align:center}.large-orb{width:74px;height:74px;margin:0 auto 22px;display:flex;align-items:center;justify-content:center;border:1px solid #90b8a540;border-radius:50%;box-shadow:0 0 60px #7bada726}.large-orb span{width:50px;height:50px;border-radius:50%;background:radial-gradient(circle at 30% 25%,#d4e8d7,#8faeaa 50%,#627882 75%);box-shadow:0 0 25px #9bc7b155}.auth-card h1{font-size:45px;font-weight:380;letter-spacing:.04em;margin:9px 0}.tagline{font-size:13px;color:#c5d5cc;letter-spacing:.08em}.intro{font-size:12px;line-height:1.95;color:var(--muted);margin:21px 0 25px}.auth-card form{text-align:left}.auth-card form button{margin-top:11px}.auth-card details{text-align:left;border-top:1px solid var(--line);margin-top:20px;padding-top:15px}.auth-card summary{font-size:12px;cursor:pointer;color:#b6c9c1}.auth-