  (call decl_c7f997eedeaf51885599c21a1e253c0f (i64 200) (call pkg_10000000000000000000000000000001/decl_a84fb8598c42e86ff66208829b86ae55 (text ":root{color-scheme:dark;--bg:#10171c;--surface:rgba(22,31,38,.93);--line:rgba(169,192,204,.15);--text:#e4ebe9;--muted:#8da29f;--green:#9dd5bc;--purple:#b9a5ed;--shadow:0 15px 60px #0006;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans JP\",sans-serif;font-size:14px}\n*{box-sizing:border-box}body{margin:0;overflow:hidden;background:var(--bg);color:var(--text)}button,input,select{font:inherit}button{border:1px solid var(--line);background:#26343c;color:var(--text);border-radius:10px;padding:10px 13px;cursor:pointer;transition:background .15s,border-color .15s,transform .15s;min-height:40px}button:hover:not(:disabled){background:#354750;border-color:#9ac0b966}button:active:not(:disabled){transform:translateY(1px)}button:disabled{opacity:.4;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid var(--green);outline-offset:3px}button.primary{background:var(--green);border-color:var(--green);color:#152d25;font-weight:650}button.primary:hover:not(:disabled){background:#b7e5cf}button.quiet{background:transparent}button.active{background:#315046;border-color:#83bba77a;color:#c0ead7}.icon{font-size:22px;line-height:1;padding:5px 12px;background:transparent}.wide{display:flex;width:100%;align-items:center;justify-content:center;gap:10px}.hidden{display:none!important}.glass{background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}.eyebrow{font-size:10px;letter-spacing:.2em;color:var(--muted);font-weight:600}.muted{color:var(--muted)}.small{font-size:12px;line-height:1.65}h1,h2,h3,p{margin:0}h2{font-size:20px;font-weight:550}h3{font-size:14px;font-weight:600}input,select{width:100%;background:#101b21;border:1px solid #435650;border-radius:9px;color:var(--text);padding:12px;min-height:44px;outline:none}input::placeholder{color:#758885}label{font-size:12px;color:var(--muted);display:block;margin-bottom:8px}.close{position:absolute;right:12px;top:12px}.pill{display:inline-block;border:1px solid #a0caba33;background:#9dd5bc0f;color:#bce3d2;font-size:12px;padding:4px 8px;border-radius:20px}.button-row{display:flex;gap:8px;flex-wrap:wrap}.error{color:#edaaa0;line-height:1.5}.empty{padding:20px 0;color:var(--muted);line-height:1.8}\n#world{position:fixed;inset:0;width:100%;height:100%;touch-action:none}.topbar{position:fixed;top:18px;left:18px;right:18px;display:flex;align-items:center;gap:12px;padding:10px 16px;border-radius:15px;z-index:5}.brand{border:0;background:none;padding:0;display:flex;align-items:center;gap:12px;font-size:21px;letter-spacing:.05em;text-align:left}.brand:hover:not(:disabled){background:none;border:none}.brand small{display:block;font-size:10px;font-weight:400;color:var(--muted);letter-spacing:.1em;margin-top:2px}.brand-orb{display:block;width:33px;height:33px;border-radius:50%;border:1px solid #c9e8d399;background:radial-gradient(circle at 35% 30%,#d3e7cb,#7ea6a2 50%,#566778);box-shadow:0 0 24px #9dd5bc30}.top-stats{margin-left:auto;display:flex;align-items:center;gap:22px;color:var(--muted);font-size:11px}.top-stats b{font-weight:400}.status-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#849d93;margin-right:7px}.status-dot.online{background:#a0d9b5;box-shadow:0 0 8px #a0d9b555}.status-dot.offline{background:#e3a789}\n.colony-hud{position:fixed;top:103px;left:18px;width:280px;border-radius:15px;padding:20px;z-index:3}.hud-name{position:relative}.hud-name h1{font-size:21px;font-weight:550;margin:8px 0;overflow-wrap:anywhere;max-width:210px}.hud-name .pill{margin-top:2px}.metrics{display:grid;grid-template-columns:1fr 1fr 1fr;margin:22px 0 14px;gap:10px}.metrics div{display:flex;flex-direction:column;gap:5px}.metrics b{font-size:22px;font-weight:450;font-varia