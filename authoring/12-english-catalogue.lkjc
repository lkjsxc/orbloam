  (call decl_c7f997eedeaf51885599c21a1e253c0f (i64 200) (call pkg_10000000000000000000000000000001/decl_a84fb8598c42e86ff66208829b86ae55 (text "{\"name\":\"Orbloam\",\"version\":2,\"tagline\":\"Little lives. A world of their own.\",\"step_ms\":10000,\"lifespan_ticks\":90,\"cell_size\":128,\"world_bound\":1000000,\"maximum_cores\":64,\"maximum_deposits\":4096,\"items\":[{\"key\":\"timber\",\"name\":\"Timber\",\"color\":\"#72cda0\",\"tier\":0},{\"key\":\"stone\",\"name\":\"Stone\",\"color\":\"#b1bacc\",\"tier\":0},{\"key\":\"fiber\",\"name\":\"Fiber\",\"color\":\"#d0bc87\",\"tier\":0},{\"key\":\"grain\",\"name\":\"Grain\",\"color\":\"#e5bc68\",\"tier\":0},{\"key\":\"ore\",\"name\":\"Ore\",\"color\":\"#c496a0\",\"tier\":0},{\"key\":\"clay\",\"name\":\"Clay\",\"color\":\"#d79b7a\",\"tier\":0},{\"key\":\"crystal\",\"name\":\"Crystal\",\"color\":\"#a998eb\",\"tier\":0},{\"key\":\"water\",\"name\":\"Water\",\"color\":\"#79c9e3\",\"tier\":0},{\"key\":\"plank\",\"name\":\"Plank\",\"color\":\"#72cda0\",\"tier\":1},{\"key\":\"beam\",\"name\":\"Beam\",\"color\":\"#72cda0\",\"tier\":2},{\"key\":\"laminate\",\"name\":\"Laminate\",\"color\":\"#72cda0\",\"tier\":3},{\"key\":\"hardwood\",\"name\":\"Hardwood\",\"color\":\"#72cda0\",\"tier\":4},{\"key\":\"resinwood\",\"name\":\"Resinwood\",\"color\":\"#72cda0\",\"tier\":5},{\"key\":\"engineered-wood\",\"name\":\"Engineered Wood\",\"color\":\"#72cda0\",\"tier\":6},{\"key\":\"living-wood\",\"name\":\"Living Wood\",\"color\":\"#72cda0\",\"tier\":7},{\"key\":\"harmonic-wood\",\"name\":\"Harmonic Wood\",\"color\":\"#72cda0\",\"tier\":8},{\"key\":\"heartwood\",\"name\":\"Heartwood\",\"color\":\"#72cda0\",\"tier\":9},{\"key\":\"brick\",\"name\":\"Brick\",\"color\":\"#b1bacc\",\"tier\":1},{\"key\":\"tile\",\"name\":\"Tile\",\"color\":\"#b1bacc\",\"tier\":2},{\"key\":\"glass\",\"name\":\"Glass\",\"color\":\"#b1bacc\",\"tier\":3},{\"key\":\"ceramic\",\"name\":\"Ceramic\",\"color\":\"#b1bacc\",\"tier\":4},{\"key\":\"porcelain\",\"name\":\"Porcel