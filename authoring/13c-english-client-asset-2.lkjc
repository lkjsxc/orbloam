  (call decl_c7f997eedeaf51885599c21a1e253c0f (i64 200) (call pkg_10000000000000000000000000000001/decl_a84fb8598c42e86ff66208829b86ae55 (text "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#111e22\"><meta name=\"description\" content=\"Orbloam — little lives, a world of their own. A quiet shared colony game.\">\n<title>Orbloam — Little lives. A world of their own.</title>\n<link rel=\"stylesheet\" href=\"./styles.css\"><script type=\"module\" src=\"./client.js\"></script>\n</head>\n<body>\n<canvas id=\"world\" aria-label=\"Shared world. Drag to pan, scroll or pinch to zoom. Click a resident, resource, workshop, or core to inspect. Click empty ground to move your core.\" tabindex=\"0\"></canvas>\n<header class=\"topbar chrome\">\n <button id=\"home-brand\" class=\"wordmark\" title=\"Return to your core\">orbloam<span class=\"brand-dot\"></span></button>\n <button id=\"colony-hud\" class=\"colony-chip glass hidden\" aria-label=\"Open colony details\"><span id=\"colony-name\"></span><span class=\"chip-divider\"></span><span title=\"Residents\"><b id=\"population\">0</b><small>lives</small></span><span class=\"essence\" title=\"Essence\"><i>✧</i><b id=\"essence\">0</b></span></button>\n <div class=\"top-right\"><span id=\"connection\" title=\"Connection status\"><i id=\"status-dot\" class=\"status-dot\"></i><span id=\"network\" class=\"sr-only\">Connecting</span></span><button id=\"menu-button\" class=\"round-button\" aria-label=\"Open menu\" title=\"Menu\">···</button></div>\n</header>\n<aside id=\"sidebar\" class=\"drawer glass hidden chrome\" aria-label=\"Colony details\">\n <div class=\"side-heading\"><div><span class=\"eyebrow\">YOUR LITTLE WORLD</span><h2 id=\"panel-title\">Colony</h2></div><button id=\"close-sidebar\" class=\"icon\" aria-label=\"Close colony panel\">×</button></div>\n <nav class=\"tabs\" aria-label=\"Colony panels\"><button data-tab=\"overview\">Overview</button><button data-tab=\"inventory\">Stores</button><button data-tab=\"industry\">Workshops</button><button data-tab=\"neighbors\">Neighbors</button></nav>\n <div id=\"panel-content\" class=\"panel-content\"></div>\n</aside>\n<section id=\"selection\" class=\"selection glass hidden chrome\" aria-label=\"Selection details\"><button id=\"close-selection\" class=\"icon close\" aria-label=\"Close selection\">×</button><div id=\"selection-body\"></div></section>\n<footer id=\"toolbar\" class=\"dock glass hidden chrome\" aria-label=\"Game tools\">\n <button id=\"open-research\"><span class=\"tool-icon\">♧</span><span>Research</span></button><span class=\"dock-divider\"></span><button id=\"build-mode\"><span class=\"tool-icon\">⌂</span><span>Build</span></button><button id=\"inventory-button\"><span class=\"tool-icon\">◫</span><span>Colony</span></button>\n</footer>\n<div id=\"camera-tools\" class=\"camera-tools hidden chrome\"><button id=\"center\" class=\"round-button\" aria-label=\"Center on your core\" title=\"Home\">◎</button><div class=\"zoom-controls glass\"><button id=\"zoom-out\" aria-label=\"Zoom out\">−</button><span id=\"zoom-label\">125%</span><button id=\"zoom-in\" aria-label=\"Zoom in\">+</button></div></div>\n<div id=\"scale\" class=\"map-scale chrome\"><span id=\"scale-line\"></span><span id=\"scale-label\"></span><small id=\"survey\"></small></div>\n<div id=\"mode-hint\" class=\"mode-hint hidden chrome\"><span id=\"mode-text\"></span><button id=\"cancel-mode\">Cancel</button></div>\n<div id=\"hover-label\" class=\"hover-label hidden\" aria-hidden=\"true\"></div>\n<div id=\"toast\" class=\"toast hidden\" role=\"status\"></div>\n<div id=\"backlog\" class=\"notice progress-notice glass hidden\" role=\"status\"><span class=\"spinner\"></span><span><b>Catching up</b><small id=\"backlog-text\"></small></span></div>\n<div id=\"pending\" class=\"notice glass hidden\" role=\"status\"><span id=\"pending-text\">Checking your last action…</span><button id=\"retry-pending\">Check again</button><button id=\"discard-pending\" class=\"quiet\">Review</button></div>\n<div id=\"backup-key\" class=\"notice glass hidden\"><span>Keep a recovery key for this core.</span><button id=\"save-first-key\">Save key</button><button id=\"dismiss-key\" class=\"icon\" aria-label=\"Dismiss reminder\">×</button></div>\n<div id=\"auth\" class=\"veil\">\n <section class=\"auth-card glass\"><canvas id=\"auth-orb\" width=\"256\" height=\"256\" aria-hidden=\"true\"></canvas><span class=\"eyebrow\">A QUIET, SHARED WORLD</span><h1>Orbloam</h1><p class=\"tagline\">Little lives. A world of their own.</p><p class=\"intro\">A small light becomes a home.<br>Let life gather, create, and begin again.</p>\n <form id=\"join-form\"><label for=\"nickname\">Name your colony</label><input id=\"nickname\" name=\"nickname\" required maxlength=\"32\" placeholder=\"A little place called…\" autocomplete=\"off\"><button class=\"primary wide\" type=\"submit\">Begin a new life <span>↗</span></button></form>\n <details><summary>Return with a recovery key</summary><form id=\"recover-form\"><label for=\"recovery-key\">Your 64-character key</label><input id=\"recovery-key\" type=\"password\" required minlength=\"64\" maxlength=\"64\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"Paste your saved key\"><button type=\"submit\" class=\"wide\">Return to your core</button></form></details>\n <label class=\"remember\"><input id=\"remember\" type=\"checkbox\" checked>Remember me on this browser</label><p id=\"auth-error\" class=\"error\" role=\"alert\"></p><p class=\"small muted\">A name is not a login. Keep your recovery key private.</p>\n </section>\n</div>\n<section id=\"research-overlay\" class=\"research-overlay hidden\" aria-label=\"Research tree\">\n <canvas id=\"research-canvas\" tabindex=\"0\" aria-label=\"A branching research tree with 96 discoveries. Drag to pan, scroll or pinch to zoom. Use Browse for keyboard access.\"></canvas>\n <header class=\"research-heading\"><div><button id=\"research-close\" class=\"quiet\">← World</button><span class=\"eyebrow\">GROW IN YOUR OWN DIRECTION</span><h1>Research <small id=\"research-progress\"></small></h1></div><div class=\"research-tools glass\"><span id=\"research-essence\" class=\"essence\"></span><button id=\"research-list-toggle\">Browse</button><button id=\"research-fit\" aria-label=\"Fit the entire tree\">Fit</button><button id=\"research-minus\" aria-label=\"Zoom research out\">−</button><button id=\"research-plus\" aria-label=\"Zoom research in\">+</button></div></header>\n <aside id=\"research-detail\" class=\"research-detail glass hidden\" aria-label=\"Discovery details\"></aside>\n <aside id=\"research-list\" class=\"research-list glass hidden\" aria-label=\"Browse discoveries\"></aside>\n <p class=\"tree-guide\">One root. Many paths. <span>Choose a glowing discovery to begin.</span></p>\n</section>\n<dialog id=\"menu-dialog\" class=\"glass dialog menu-dialog\"><button class=\"icon close\" data-close=\"menu-dialog\" aria-label=\"Close menu\">×</button><span class=\"eyebrow\">ORBLOAM</span><h2>Make yourself at home.</h2><button id=\"help-button\" class=\"wide\">How life works</button><button id=\"key-button\" class=\"wide\">Recovery key</button><button id=\"hide-ui\" class=\"wide\">Hide interface <kbd>H</kbd></button><p class=\"small muted\">Click to discover. Drag to wander.<br>Everything else can wait.</p></dialog>\n<dialog id=\"help-dialog\" class=\"glass dialog\"><button class=\"icon close\" data-close=\"help-dialog\" aria-label=\"Close help\">×</button><span class=\"eyebrow\">A LITTLE GUIDANCE</span><h2>Watch. Wander. Let life grow.</h2>\n <h3>Fifteen little minutes</h3><p>Residents gather and work by themselves. A life lasts 15 minutes, then returns Essence to your core and begins a new generation. Research and buildings remain. Your first 16 places fill gradually; Vitality discoveries add 48 more.</p>\n <h3>Your world, not a dashboard</h3><p>Click a core, resident, resource, or workshop for details. Click empty ground to move your core. Drag to pan and scroll or pinch to zoom. In the distant atlas, click a region to see its resources or double-click to look closer. Home returns to your core; Escape closes a panel. H hides the interface.</p>\n <h3>A tree, not a checklist</h3><p>Each family forks into separate paths. A discovery requires its connected parent, not every earlier number. Every discovery strengthens that family. Nothing is lost when you choose another branch later.</p>\n <h3>Workshops think for themselves</h3><p>Build a workshop once. It chooses unlocked, affordable recipes according to the stock you need, finishes work in progress, and maintains itself while near your core and supplied with workers, timber, and stone. Open a workshop only to override its recipe, pause it, repair it immediately, or dismantle it.</p>\n <h3>The wider landscape</h3><p>Deposits are finite and shared. They regrow over time. Moving and researching Reach open richer gathering areas. At a distance, the atlas combines deposits into true regional totals; it does not change the simulation. Walking and carrying are visual representations, not individual pathfinding.</p>\n <h3>Away and back again</h3><p>The native server resolves elapsed 10-second steps in order when someone connects. After a long absence, catch-up can delay actions. An uncertain action is retried with the same ID, never silently duplicated. Keep both your recovery key and the server’s data backup.</p><button class=\"primary wide\" data-close=\"help-dialog\">Back to the world</button></dialog>\n<dialog id=\"key-dialog\" class=\"glass dialog\"><button class=\"icon close\" data-close=\"key-dialog\" aria-label=\"Close recovery key\">×</button><span class=\"eyebrow\">YOUR RECOVERY KEY</span><h2>A way back to this little world.</h2><p>This is a password. Anyone who has it can control your core.</p><input id=\"key-value\" type=\"password\" readonly autocomplete=\"off\" aria-label=\"Recovery key\"><div class=\"button-row\"><button id=\"reveal-key\">Reveal</button><button id=\"copy-key\">Copy</button><button id=\"download-key\" class=\"primary\">Save file</button></div><p class=\"small muted\">The same key works on another device connected to this server. It is not a backup of the world itself.</p><button id=\"logout\" class=\"wide quiet\">Sign out of this browser</button></dialog>\n<button id=\"restore-ui\" class=\"restore-ui hidden\" aria-label=\"Show interface\">Show interface · H</button>\n</body>\n</html>\n")) (text "text/html; charset=utf-8"))
expression.end
replace.body function=decl_cd779bd86c804b79e6d4de623bb7c615 body=$update-asset-2-body
