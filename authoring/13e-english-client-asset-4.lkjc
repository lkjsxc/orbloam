  (call decl_c7f997eedeaf51885599c21a1e253c0f (i64 200) (call pkg_10000000000000000000000000000001/decl_a84fb8598c42e86ff66208829b86ae55 (text ":root{color-scheme:dark;--bg:#111e22;--surface:rgba(20,35,39,.93);--line:#afcabb21;--text:#e1e9df;--muted:#96aaa3;--green:#b8d9c1;--purple:#c4b1eb;--shadow:0 20px 80px #020d184d;font:14px/1.5 ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);overflow:hidden}button,input,select{font:inherit}button{color:inherit;background:#d0e5d708;border:1px solid var(--line);border-radius:10px;min-height:40px;padding:9px 14px;cursor:pointer;transition:background .16s,border-color .16s}button:hover:not(:disabled){background:#c9e1cc12;border-color:#cce8d34a}button:active:not(:disabled){background:#c9e1cc22}button:disabled{opacity:.4;cursor:not-allowed}button:focus-visible,summary:focus-visible,input:focus-visible,select:focus-visible,canvas:focus-visible{outline:2px solid #c1dab2;outline-offset:4px}button.primary{background:var(--green);border-color:var(--green);color:#1a3430;font-weight:600}button.primary:hover:not(:disabled){background:#d3e6cb}.quiet{background:transparent;border-color:transparent}.icon{background:transparent;border:0;font-size:22px;line-height:1;padding:6px 10px}.close{position:absolute;right:10px;top:10px}.wide{display:flex;justify-content:center;align-items:center;gap:12px;width:100%}.glass{background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px)}.hidden{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;clip:rect(0,0,0,0);white-space:nowrap;overflow:hidden}.eyebrow{display:block;font-size:9px;letter-spacing:.19em;font-weight:550;color:var(--muted)}.muted,.small{color:var(--muted)}.small{font-size:11px;line-height:1.8}.error{color:#e6a89d}.essence{color:var(--purple);font-variant-numeric: